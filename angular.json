{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "zegrana": {
      "projectType": "application",
      "root": "frontend",
      "sourceRoot": "frontend/src",
      "prefix": "zg",
      "architect": {
        "build": { "builder": "@angular/build:application", "options": { "browser": "frontend/src/main.ts", "tsConfig": "frontend/tsconfig.app.json", "assets": [], "styles": ["frontend/src/styles.css"] }, "configurations": { "production": { "budgets": [{ "type": "initial", "maximumWarning": "800kB", "maximumError": "1MB" }], "outputHashing": "all" } } },
        "serve": { "builder": "@angular/build:dev-server", "configurations": { "production": { "buildTarget": "zegrana:build:production" }, "development": { "buildTarget": "zegrana:build" } }, "defaultConfiguration": "development" }
      }
    }
  }
}
